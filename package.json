{
  "name": "@todrink/dsh-session-delete",
  "version": "1.0.1",
  "type": "module",
  "description": "Adds Delete session to the session menu, below Archive: permanently removes a stored session and its local history.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.2-rc.5"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "session",
    "delete",
    "context-menu",
    "cleanup"
  ],
  "license": "MIT",
  "author": {
    "name": "todrink",
    "url": "https://github.com/todrinkcho"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/todrinkcho/dsh-session-delete.git"
  },
  "homepage": "https://github.com/todrinkcho/dsh-session-delete#readme",
  "bugs": {
    "url": "https://github.com/todrinkcho/dsh-session-delete/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
